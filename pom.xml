<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.github.darshanredkar11</groupId>
  <artifactId>json-serializer</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>
  <name>json-serializer</name>
  <description>Fast, dependency-free JSON serialization and parsing for Java with no runtime reflection and no intermediate tree.</description>
  <url>https://github.com/darshanredkar11/json-serializer</url>

  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/license/mit</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>darshanredkar11</id>
      <name>Darshan Redkar</name>
      <url>https://github.com/darshanredkar11</url>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:git://github.com/darshanredkar11/json-serializer.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/darshanredkar11/json-serializer.git</developerConnection>
    <url>https://github.com/darshanredkar11/json-serializer</url>
    <tag>json-serializer-1.0.0</tag>
  </scm>

  <issueManagement>
    <system>GitHub Issues</system>
    <url>https://github.com/darshanredkar11/json-serializer/issues</url>
  </issueManagement>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>17</maven.compiler.release>
  </properties>

  <!--
    No runtime or test dependencies, on purpose — see README.md. The test
    suite (JsonTest, CodecsTest, ConcurrencyTest, Bench) is a plain `main()`
    runner, not JUnit, so this stays true even with Maven packaging added on
    top of the original `javac`-only build (`build.sh` still works unchanged).
  -->

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-source-plugin</artifactId>
        <version>3.4.0</version>
        <executions>
          <execution>
            <id>attach-sources</id>
            <phase>package</phase>
            <goals><goal>jar-no-fork</goal></goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-javadoc-plugin</artifactId>
        <version>3.12.0</version>
        <configuration>
          <doclint>none</doclint>
        </configuration>
        <executions>
          <execution>
            <id>attach-javadocs</id>
            <phase>package</phase>
            <goals><goal>jar</goal></goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <!-- This module never needs to self-process: JsonRecordProcessor
               is a bundled processor for *consumers*, not for anything in
               this source tree. Disabling annotation processing here also
               sidesteps a real bootstrapping hazard — process-resources
               copies META-INF/services/javax.annotation.processing.Processor
               into target/classes before compile runs, which could make
               javac try to load JsonRecordProcessor as a processor while
               its own .java source is still mid-compilation in this exact
               invocation. -->
          <proc>none</proc>
        </configuration>
      </plugin>
      <plugin>
        <!-- Test classes have `main()` runners, not JUnit tests; skip
             surefire's discovery (it would find nothing) and instead run
             them explicitly as part of the build via exec-maven-plugin. -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.3.1</version>
        <configuration>
          <skipTests>true</skipTests>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.4.0</version>
        <executions>
          <execution>
            <id>run-json-test</id>
            <phase>test</phase>
            <goals><goal>java</goal></goals>
            <configuration>
              <mainClass>json.JsonTest</mainClass>
              <classpathScope>test</classpathScope>
              <!-- JsonTest.main() calls System.exit(1) on failure; fork so
                   that only kills this test's JVM, not Maven's own. -->
              <fork>true</fork>
            </configuration>
          </execution>
          <execution>
            <id>run-codecs-test</id>
            <phase>test</phase>
            <goals><goal>java</goal></goals>
            <configuration>
              <mainClass>json.CodecsTest</mainClass>
              <classpathScope>test</classpathScope>
              <fork>true</fork>
            </configuration>
          </execution>
          <execution>
            <id>run-json-record-processor-test</id>
            <phase>test</phase>
            <goals><goal>java</goal></goals>
            <configuration>
              <mainClass>json.processor.JsonRecordProcessorTest</mainClass>
              <classpathScope>test</classpathScope>
              <fork>true</fork>
            </configuration>
          </execution>
          <execution>
            <id>run-concurrency-test</id>
            <phase>test</phase>
            <goals><goal>java</goal></goals>
            <configuration>
              <mainClass>json.ConcurrencyTest</mainClass>
              <classpathScope>test</classpathScope>
              <fork>true</fork>
            </configuration>
          </execution>
        </executions>
      </plugin>
            <plugin>
        <groupId>org.sonatype.central</groupId>
        <artifactId>central-publishing-maven-plugin</artifactId>
        <version>0.11.0</version>
        <extensions>true</extensions>
        <configuration>
          <publishingServerId>central</publishingServerId>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>3.2.8</version>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals><goal>sign</goal></goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>

  <distributionManagement>
    <snapshotRepository>
      <id>central</id>
      <url>https://central.sonatype.com/repository/maven-snapshots/</url>
    </snapshotRepository>
    <repository>
      <id>central</id>
      <url>https://central.sonatype.com/api/v1/publisher/deploy</url>
    </repository>
  </distributionManagement>

</project>
